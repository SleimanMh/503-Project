# AWS Credentials Secret — template only, do NOT commit real credentials.
#
# Fill in the values below, then apply with:
#   kubectl apply -f k8s/aws-credentials-secret.yaml
#
# For production EKS, prefer IAM Roles for Service Accounts (IRSA) instead
# of embedding access keys. With IRSA you don't need this secret at all —
# just annotate the service account with the IAM role ARN.
#
# HOW TO CREATE THE BUCKET:
#   aws s3 mb s3://ev-charging-ml-<your-account-id> --region us-east-1
#
# MINIMUM IAM POLICY for the credentials below (attach to the IAM user/role):
#   {
#     "Effect": "Allow",
#     "Action": [
#       "s3:PutObject",
#       "s3:GetObject",
#       "s3:ListBucket"
#     ],
#     "Resource": [
#       "arn:aws:s3:::ev-charging-ml-*",
#       "arn:aws:s3:::ev-charging-ml-*/*"
#     ]
#   }
#
# DynamoDB (for user profiles — if USER_PROFILES_BACKEND=dynamodb):
#   Add: dynamodb:GetItem, dynamodb:PutItem on table ev-user-profiles
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-credentials
  namespace: ev-charging
type: Opaque
stringData:
  bucket: "ev-charging-ml-REPLACE_WITH_ACCOUNT_ID"
  region: "us-east-1"
  aws_access_key_id: "REPLACE_WITH_ACCESS_KEY"
  aws_secret_access_key: "REPLACE_WITH_SECRET_KEY"
